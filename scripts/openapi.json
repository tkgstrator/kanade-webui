    "/api/queues/:album_id": {
      "get": {
        "description": "Retrieves detailed information about a specific album by its ID.",
        "summary": "Add A Download Album Queue to Redis",
        "tags": [
          "Albums"
        ],
        "parameters": [
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "description": "The unique identifier for the album."
            },
            "required": false,
            "description": "The unique identifier for the album.",
            "name": "album_id",
            "in": "path"
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response with album details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "url"
                      ]
                    },
                    "id": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "timestamp": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "data",
                    "id",
                    "timestamp"
                  ]
                }
              }
