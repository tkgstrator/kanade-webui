  "paths": {
    "/api/search": {
      "get": {
        "description": "Searches the Apple Music catalog for songs, albums, artists, and playlists matching the query parameter 'q'.",
        "summary": "Search the Apple Music catalog",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The search query string."
            },
            "required": true,
            "description": "The search query string.",
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
